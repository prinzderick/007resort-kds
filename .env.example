# 007resort-kds configuration (placeholders only - never commit real values).
# Copy to `.env.local` (git-ignored) for local development.
# Values are compiled into the bundle and are NOT secret. The same keys can be overridden
# at deploy time, without rebuilding, in `config.json` next to index.html.

# Base URL of the 007 Resort & Spa API (no trailing /api/v1).
# Use the literal `origin` when the web server that serves this bundle also proxies /api and
# the socket (same-origin deployment).
VITE_R007_API_BASE_URL=http://localhost:5080

# Laravel Reverb (Pusher protocol). If none of these four are set, the KDS uses the values the
# node advertises in GET /api/v1/system/info -> `realtime`.
# The mock server (`npm run mock`) serves its socket on the same port as its API.
VITE_R007_REVERB_HOST=localhost
VITE_R007_REVERB_PORT=5080
VITE_R007_REVERB_SCHEME=http
# Public app key only - never the Reverb app secret.
VITE_R007_REVERB_KEY=r007-local-key

# Optional preset station code (normally chosen on the device's setup screen and remembered).
VITE_KDS_STATION_CODE=

# Ticket ageing colours: amber after WARN minutes, red after LATE minutes (device menu can override).
VITE_KDS_WARN_MINUTES=5
VITE_KDS_LATE_MINUTES=10
# Staff auto-lock after this many idle seconds (0 = never). The board stays visible while locked.
VITE_KDS_IDLE_LOCK_SECONDS=120
# Safety-net full reload while connected, seconds (0 = off).
VITE_KDS_RESYNC_SECONDS=300
