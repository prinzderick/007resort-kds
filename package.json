    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  },
  "description": "007 Resort & Spa Kitchen Display System (KDS) kiosk client - thin client of the 007 Resort & Spa API",
